{
  "name": "dailymeal-workspace",
  "version": "1.0.0",
  "description": "DailyMeal 풀스택 애플리케이션",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:pm2": "./bin/start-pm2.sh",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "npm run test:backend && npm run test:frontend && npm run test:app",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test -- --run",
    "test:app": "cd app && npm test",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:frontend && npm run test:coverage:app",
    "test:coverage:backend": "cd backend && npm run test:cov",
    "test:coverage:frontend": "cd frontend && npm run test:coverage",
    "test:coverage:app": "cd app && npm run test:coverage",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../app && npm install",
    "build:all": "cd frontend && npm run build && cd ../backend && npm run build",
    "deploy": "./bin/deploy.sh",
    "stop": "./bin/stop-pm2.sh all",
    "stop:dev": "./bin/stop-pm2.sh dev",
    "stop:prod": "./bin/stop-pm2.sh prod",
    "lint:all": "cd frontend && npm run lint && cd ../backend && npm run lint",
    "format": "prettier --write \"*.{js,json,md}\"",
    "format:check": "prettier --check \"*.{js,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "eslint-config-next": "^15.5.4",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "tailwind-merge": "^3.3.1"
  }
}
