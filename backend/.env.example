# ==============================================
# DailyMeal Backend Environment Configuration
# ==============================================
# 
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 환경에 맞게 값 수정
# 3. .env 파일은 Git에 커밋하지 않음 (.gitignore에 포함됨)
#
# 개발 환경: localhost 값 사용
# 운영 환경: 실제 도메인, 강력한 시크릿 사용
# ==============================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dailymeal_user
DB_PASSWORD=your_password_here
DB_NAME=dailymeal

# JWT Configuration
# IMPORTANT: Change this in production!
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Encryption Configuration (for share ref parameter)
ENCRYPTION_KEY=your-32-character-encryption-key!

# Frontend URL (for share links)
FRONTEND_URL=http://localhost:3000

# CORS Origins (comma-separated)
# Development: localhost + WSL IP
# Production: your domain(s)
CORS_ORIGINS=http://localhost:3000,http://172.21.114.94:3000,http://www.dailymeal.life,https://www.dailymeal.life

# API Base URL (for image URLs in responses)
API_BASE_URL=http://localhost:8000

# Server Configuration
PORT=8000
NODE_ENV=development

# File Upload Configuration
UPLOAD_DIR=/data/uploads/dailymeal
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=5

# Email Configuration (for password reset, etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false # true for 465, false for other ports
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM='"DailyMeal" <noreply@example.com>'
