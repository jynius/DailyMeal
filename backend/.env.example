# ==============================================
# DailyMeal Backend Environment Configuration
# ==============================================
# 
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 환경에 맞게 값 수정
# 3. .env 파일은 Git에 커밋하지 않음 (.gitignore에 포함됨)
#
# 개발 환경: localhost 값 사용
# 운영 환경: 실제 도메인, 강력한 시크릿 사용
# ==============================================
# Server Configuration
NODE_ENV=development
PORT=8000

# Frontend URL (for share links - 공유 링크 생성용)
# 개발: http://localhost:3000
# 운영: https://www.dailymeal.life
FRONTEND_URL=http://localhost:3000

# Image Base URL (for image URL prefix - 이미지 URL 접두사)
# 개발: http://localhost:8000 (절대 경로로 변환)
# 운영: (빈값) - 상대 경로 유지, Nginx가 /uploads/ 직접 서빙
IMAGE_BASE_URL=http://localhost:8000

# JWT Configuration
# IMPORTANT: Change this in production!
JWT_SECRET=your-jwt-secret-key-change-this-in-production
# Encryption Configuration (for share ref parameter)
ENCRYPTION_KEY=your-32-character-encryption-key!

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dailymeal
DB_USERNAME=dailymeal_user
DB_PASSWORD=your_password_here

# File Upload Configuration
UPLOAD_DIR=/data/uploads/dailymeal
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=5

# Kakao API Configuration (for AI recommendations)
# Get your REST API Key from: https://developers.kakao.com/
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Email Configuration (for password reset, etc.)
EMAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
EMAIL_PORT=2587
EMAIL_SECURE=true # true for 465, false for other ports
EMAIL_USER=your_email_smtp_username_encrypted
EMAIL_PASS=your_email_smtp_password_encrypted
EMAIL_FROM='"DailyMeal" <noreply@dailymeal.life>'

# CORS Origins (comma-separated)
# Development: localhost + WSL IP
# Production: your domain(s)
CORS_ORIGINS=http://localhost:3000,http://172.24.172.135:3000
