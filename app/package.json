{
  "name": "app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "REACT_NATIVE_PACKAGER_HOSTNAME=192.168.219.103 expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:dev": "cp config/env.local .env && npx expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "build:preview": "cp config/env.preview .env && npx expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "build:prod": "cp config/env.production .env && npx expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:production": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-kakao/core": "^2.4.2",
    "@react-native-kakao/share": "^2.4.2",
    "@react-native-kakao/social": "^2.4.2",
    "expo": "^54.0.13",
    "expo-constants": "^18.0.9",
    "expo-document-picker": "^14.0.7",
    "expo-image-picker": "^17.0.8",
    "expo-linking": "^8.0.8",
    "expo-navigation-bar": "~5.0.8",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-webview": "13.15.0"
  },
  "private": true,
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.1",
    "babel-jest": "^30.2.0",
    "eas-cli": "^16.20.4",
    "jest": "^30.2.0",
    "react-test-renderer": "^19.1.0"
  }
}
