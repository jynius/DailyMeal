# ==============================================
# DailyMeal Frontend Production Configuration
# ==============================================
# 
# 사용 방법:
# 1. 이 파일을 .env.production으로 복사
# 2. 실제 도메인과 API 키로 변경
# 3. npm run build 시 자동으로 로드됨
#
# 주의: NODE_ENV는 Next.js가 자동 설정 (명시 불필요)
# ==============================================

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 로그 레벨 설정 (ERROR, WARN, INFO, DEBUG, TRACE)
# 운영: ERROR (오류만), 개발: DEBUG (상세 로그)
NEXT_PUBLIC_LOG_LEVEL=ERROR

# 카카오 API 설정
# JavaScript 키를 입력하세요 (https://developers.kakao.com)
NEXT_PUBLIC_KAKAO_API_KEY=your_kakao_javascript_key_here
