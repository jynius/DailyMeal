# DailyMeal Frontend Environment Variables

# ==============================================
# Server URLs (분리 아키텍처)
# ==============================================

# Site URL (frontend)
# 개발 (WSL2 내부): http://localhost:3000
# 개발 (Windows 네트워크 - Expo 등): http://192.168.219.103:3000
#   → Port forwarding에 의해 172.21.114.94:3000로 자동 변환됨
# 개발 (WSL2 IP 직접 사용): http://172.21.114.94:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server URL (정적 파일용)
# 용도: 이미지/업로드 파일 접근 (/uploads/*)
# 개발 (WSL2 내부): http://localhost:8000
# 개발 (Windows 네트워크): http://192.168.219.103:8000
# 개발 (WSL2 IP 직접): http://172.21.114.94:8000
# 운영 (미래): https://cdn.dailymeal.com (S3/CDN 분리)
NEXT_PUBLIC_SERVER_URL=http://localhost:8000

# API URL (REST API용)
# 용도: REST API 호출 (/api/*)
# 개발 (WSL2 내부): http://localhost:8000/api
# 개발 (Windows 네트워크): http://192.168.219.103:8000/api
# 개발 (WSL2 IP 직접): http://172.21.114.94:8000/api
# 운영 (미래): https://api.dailymeal.com (API 서버 분리)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# 로그 레벨 설정
# 레벨: ERROR, WARN, INFO, DEBUG, TRACE
# 권장: 개발 = DEBUG, 운영 = ERROR
NEXT_PUBLIC_LOG_LEVEL=DEBUG

# Kakao API Key
# 참고: 하나의 JavaScript 키로 지도 API와 공유 기능 모두 사용 가능
# 발급 방법: https://developers.kakao.com/console/app
NEXT_PUBLIC_KAKAO_API_KEY=your_kakao_javascript_api_key_here

# 참고: 
# - 클라이언트(브라우저/Expo)에서는 192.168.219.103 사용
# - 서버 설정(CORS 등)에서는 172.21.114.94 사용
# - Windows port forwarding이 자동으로 변환 처리
